{
  "expo": {
    "name": "openScale",
    "slug": "openscale-expo",
    "scheme": "openscale",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "允許 openScale 使用藍牙搜尋體重秤"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh-Hant",
        "NSBluetoothAlwaysUsageDescription": "openScale 需要使用藍牙搜尋附近的體重秤。",
        "NSBluetoothPeripheralUsageDescription": "openScale 需要使用藍牙搜尋附近的體重秤。"
      }
    },
    "android": {
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "package": "com.chanchungyeung949.openscaleexpo"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "706db088-8067-4e7c-83c7-2f587a48410d"
      }
    }
  }
}
